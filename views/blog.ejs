<!DOCTYPE html>
<html lang="en">

<head>
    <%- include('./partials/head.ejs') %>
        <title>Blog Page</title>
</head>

<body>
    <%- include('./partials/nav.ejs') %>
        <div class="container mt-4">
            <h1>
                <%= blog.title %>
            </h1>
            <img src="<%= blog.coverImageURL %>" class="shadow" alt="Cover Image"
                style="width: 30%;margin: auto;">
            <p class="mt-5">
                <%= blog.content %>
            </p>
            <div class="container mt-4">
                <img src="<%= blog.createdBy.pfpURL %>" alt="user-icon" style="height: 30px;">
                <%= blog.createdBy.fullname %>
            </div>
            <div class="container mt-3">
                <h1>Comments (<%= comments.length %>)</h1>
                <% comments.forEach(comment=> { %>
                    <div class="container my-1 p-2 shadow">
                        <div class="m-1">
                            <img src="<%= comment.createdBy.pfpURL %>" alt="user-icon" style="height: 30px;">
                            <%= comment.createdBy.fullname %>
                        </div>
                        <div class="mt-1 ml-2 text-secondary px-2">
                            <%= comment.content %>
                        </div>
                    </div>

                    <% }) %>
                        <% if (locals.user) { %>
                            <form action="/blog/comment/<%= blog._id %>" method="post">
                                <div class="mb-3">
                                    <input type="text" class="form-control" id="content" aria-describedby="content"
                                        name="content" placeholder="Write your comment...">
                                </div>
                                <button type="submit" class="btn btn-primary">Add</button>
                            </form>
                            <% } %>
            </div>
        </div>

        <%- include('./partials/scripts.ejs') %>
</body>

</html>